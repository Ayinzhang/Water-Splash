// Weakly compressible MLS-MPM inside the bottle. One substep:
// ClearGrid -> P2G (packed 16-bit sums) -> UpdateGrid -> G2P.
#pragma kernel CacheBoundary
#pragma kernel ClearGrid
#pragma kernel P2G
#pragma kernel UpdateGrid
#pragma kernel G2P

struct Particle
{
    float4 position;  // Grid position, 1.
    float4 velocity;  // Grid velocity, density ratio.
    float4 affineX;
    float4 affineY;
    float4 affineZ;
};

RWStructuredBuffer<float4> _Particles;
uint _ParticlePlaneStride; // Five contiguous streams of this length.

float4 ParticlePosition(uint id) { return _Particles[id]; }
float4 ParticleVelocity(uint id) { return _Particles[id + _ParticlePlaneStride]; }

Particle LoadParticle(uint id)
{
    Particle p;
    p.position = _Particles[id];
    p.velocity = _Particles[id + _ParticlePlaneStride];
    p.affineX = _Particles[id + 2 * _ParticlePlaneStride];
    p.affineY = _Particles[id + 3 * _ParticlePlaneStride];
    p.affineZ = _Particles[id + 4 * _ParticlePlaneStride];
    return p;
}

void StoreParticle(uint id, Particle p)
{
    _Particles[id] = p.position;
    _Particles[id + _ParticlePlaneStride] = p.velocity;
    _Particles[id + 2 * _ParticlePlaneStride] = p.affineX;
    _Particles[id + 3 * _ParticlePlaneStride] = p.affineY;
    _Particles[id + 4 * _ParticlePlaneStride] = p.affineZ;
}



RWStructuredBuffer<int> _Accumulation;  // Two packed int16 pairs per cell: (mass, px), (py, pz).
RWStructuredBuffer<float4> _Grid;       // Velocity, mass.
RWStructuredBuffer<float4> _StaticGridBoundary;

int _ParticleCount;
int _Resolution;
int3 _GridSize;
int3 _GridOffset;
int _CellCount;
float _Dt;
float _RestDensity;
float _BulkModulus;
float _PressureExponent;
float _Viscosity;
float3 _Acceleration;
// Grid-space profile uploaded from BottleBoundary.Profile.
int _BottleProfileCount;
float4 _BottleProfile[32];
float3 _BottleCenter;
float _BottleClearance;

float BottleDistance(float3 position, out float3 normal)
{
    float3 p = position - _BottleCenter;
    float radius = _BottleProfile[0].y;
    float slope = 0;
    for (int i = 0; i < _BottleProfileCount - 1; i++)
    {
        float2 a = _BottleProfile[i].xy, b = _BottleProfile[i + 1].xy;
        if (p.x <= b.x || i == _BottleProfileCount - 2)
        {
            slope = (b.y - a.y) / (b.x - a.x);
            radius = lerp(a.y, b.y, saturate((p.x - a.x) / (b.x - a.x)));
            break;
        }
    }
    float radial = length(p.yz);
    float norm = sqrt(1 + slope * slope);
    float distance = (radial - radius) / norm;
    normal = float3(-slope, radial > 1e-7 ? p.y / radial : 1,
        radial > 1e-7 ? p.z / radial : 0) / norm;
    float back = _BottleProfile[0].x - p.x;
    float front = p.x - _BottleProfile[_BottleProfileCount - 1].x;
    if (back > distance) { distance = back; normal = float3(-1,0,0); }
    if (front > distance) { distance = front; normal = float3(1,0,0); }
    return distance;
}
bool BottleProject(inout float3 position, inout float3 velocity)
{
    bool contact = false;
    [unroll] for (int i = 0; i < 8; i++)
    {
        float3 normal;
        float distance = BottleDistance(position, normal) + _BottleClearance;
        if (distance <= 0) break;
        position -= normal * (distance + 1e-4);
        velocity -= max(dot(velocity, normal), 0) * normal;
        contact = true;
    }
    return contact;
}


static const float PackedMassScale = 512.0;
static const float PackedMomentumScale = 32.0;

uint CellIndex(int3 cell)
{
    int3 local = cell - _GridOffset;
    return local.x + _GridSize.x * (local.y + _GridSize.y * local.z);
}

bool ValidCell(int3 cell)
{
    int3 local = cell - _GridOffset;
    return all(local >= 0) && all(local < _GridSize);
}

int3 CellPosition(uint id)
{
    return _GridOffset + int3(id % _GridSize.x, (id / _GridSize.x) % _GridSize.y, id / (_GridSize.x * _GridSize.y));
}

void Weights(float3 position, out int3 origin, out float3 w[3])
{
    origin = (int3)floor(position - 0.5);
    float3 f = position - origin;
    w[0] = 0.5 * (1.5 - f) * (1.5 - f);
    w[1] = 0.75 - (f - 1.0) * (f - 1.0);
    w[2] = 0.5 * (f - 0.5) * (f - 0.5);
}

// Two signed 16-bit fixed-point sums share one 32-bit atomic. Modular addition keeps
// both halves exact as long as each final sum fits in int16; intermediates may wrap.
int PackedHalf(float value, float scale)
{
    return (int)round(value * scale);
}

void AccumulatePacked(uint address, int low, int high)
{
    InterlockedAdd(_Accumulation[address], asint(asuint(low) + (asuint(high) << 16)));
}

int2 UnpackHalves(int value)
{
    int low = (value << 16) >> 16;
    return int2(low, (value - low) >> 16);
}


[numthreads(128, 1, 1)]
void CacheBoundary(uint id : SV_DispatchThreadID)
{
    if (id >= (uint)_CellCount) return;
    float3 normal;
    float distance = BottleDistance(CellPosition(id), normal);
    _StaticGridBoundary[id] = float4(normal, distance);
}

[numthreads(128, 1, 1)]
void ClearGrid(uint id : SV_DispatchThreadID)
{
    if (id >= (uint)_CellCount) return;
    _Accumulation[id * 2] = 0;
    _Accumulation[id * 2 + 1] = 0;
    _Grid[id] = 0;
}

// Single-pass P2G: stress uses the density ratio gathered by the previous G2P (velocity.w).
[numthreads(128, 1, 1)]
void P2G(uint id : SV_DispatchThreadID)
{
    if (id >= (uint)_ParticleCount) return;
    Particle p = LoadParticle(id);
    int3 origin;
    float3 w[3];
    Weights(p.position.xyz, origin, w);
    float ratio = p.velocity.w > 0 ? p.velocity.w : 1.0;
    float density = ratio * _RestDensity;
    float compression = _PressureExponent == 3 ? ratio * ratio * ratio :
        (_PressureExponent == 1 ? ratio : pow(abs(ratio), _PressureExponent));
    float pressure = _BulkModulus * max(compression - 1.0, 0.0);
    float3x3 c = float3x3(p.affineX.xyz, p.affineY.xyz, p.affineZ.xyz);
    float3x3 stress = _Viscosity * (c + transpose(c));
    stress[0][0] -= pressure;
    stress[1][1] -= pressure;
    stress[2][2] -= pressure;
    // For the quadratic B-spline in grid coordinates, the inverse moment is 4 I.
    float3x3 q = c + (-4.0 * _Dt / density) * stress;

    uint firstCell = CellIndex(origin);
    uint sliceStride = _GridSize.x * _GridSize.y;
    for (int z = 0; z < 3; z++)
    for (int y = 0; y < 3; y++)
    [unroll]
    for (int x = 0; x < 3; x++)
    {
        int3 cell = origin + int3(x, y, z);
        float weight = w[x].x * w[y].y * w[z].z;
        float3 momentum = weight * (p.velocity.xyz + mul(q, cell - p.position.xyz));
        uint address = (firstCell + x + y * _GridSize.x + z * sliceStride) * 2;
        AccumulatePacked(address, (int)round(weight * PackedMassScale),
            PackedHalf(momentum.x, PackedMomentumScale));
        AccumulatePacked(address + 1, PackedHalf(momentum.y, PackedMomentumScale),
            PackedHalf(momentum.z, PackedMomentumScale));
    }
}

[numthreads(128, 1, 1)]
void UpdateGrid(uint id : SV_DispatchThreadID)
{
    if (id >= (uint)_CellCount) return;
    int2 a = UnpackHalves(_Accumulation[id * 2]);
    int2 b = UnpackHalves(_Accumulation[id * 2 + 1]);
    float mass = a.x / PackedMassScale;
    if (mass <= 0) return;
    float3 velocity = float3(a.y, b.x, b.y) / PackedMomentumScale / mass;
    velocity += _Acceleration * _Dt;
    int3 cell = CellPosition(id);
    float4 wall = _StaticGridBoundary[id];
    if (wall.w > -(_BottleClearance + .65))
        velocity -= max(dot(velocity, wall.xyz), 0) * wall.xyz;
    if (cell.x < 3) velocity.x = max(velocity.x, 0);
    if (cell.y < 3) velocity.y = max(velocity.y, 0);
    if (cell.z < 3) velocity.z = max(velocity.z, 0);
    if (cell.x > _Resolution - 4) velocity.x = min(velocity.x, 0);
    if (cell.y > _Resolution - 4) velocity.y = min(velocity.y, 0);
    if (cell.z > _Resolution - 4) velocity.z = min(velocity.z, 0);
    _Grid[id] = float4(velocity, mass);
}

// G2P + advection. Also gathers this substep's density ratio into velocity.w for the next P2G.
[numthreads(128, 1, 1)]
void G2P(uint id : SV_DispatchThreadID)
{
    if (id >= (uint)_ParticleCount) return;
    Particle p = LoadParticle(id);
    int3 origin;
    float3 w[3];
    Weights(p.position.xyz, origin, w);
    float3 velocity = 0;
    float3 cx = 0, cy = 0, cz = 0;
    float density = 0;
    uint firstCell = CellIndex(origin);
    uint sliceStride = _GridSize.x * _GridSize.y;
    for (int z = 0; z < 3; z++)
    for (int y = 0; y < 3; y++)
    [unroll]
    for (int x = 0; x < 3; x++)
    {
        int3 cell = origin + int3(x, y, z);
        float weight = w[x].x * w[y].y * w[z].z;
        float4 node = _Grid[firstCell + x + y * _GridSize.x + z * sliceStride];
        float3 weighted = weight * node.xyz;
        density += weight * node.w;
        float3 offset = cell - p.position.xyz;
        velocity += weighted;
        cx += 4.0 * weighted.x * offset;
        cy += 4.0 * weighted.y * offset;
        cz += 4.0 * weighted.z * offset;
    }
    float ratio = density / _RestDensity;
    p.velocity.w = ratio;

    float3 position = p.position.xyz + _Dt * velocity;
    bool contact = BottleProject(position, velocity);
    [unroll]
    for (int axis = 0; axis < 3; axis++)
    {
        if (position[axis] < 2.0)
        {
            position[axis] = 2.0;
            velocity[axis] = max(velocity[axis], 0);
            contact = true;
        }
        if (position[axis] > _Resolution - 3.0)
        {
            position[axis] = _Resolution - 3.0;
            velocity[axis] = min(velocity[axis], 0);
            contact = true;
        }
    }
    p.position = float4(position, 1);
    p.velocity.xyz = velocity;
    p.affineX = float4(contact ? 0 : cx, 0);
    p.affineY = float4(contact ? 0 : cy, 0);
    p.affineZ = float4(contact ? 0 : cz, 0);
    StoreParticle(id, p);
}
